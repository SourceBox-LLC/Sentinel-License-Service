# Sentinel License Service — environment variables

DATABASE_URL=sqlite:///./licenses.db

# Error tracking (optional). Blank in local dev — init_sentry() no-ops.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate-limiter shared storage. Without it, per-process in-memory
# counters — fine for this service's single-machine deploy.
REDIS_URL=
